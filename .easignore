# EAS builds the mobile app from this monorepo. Keep the mobile workspace,
# exclude server/source archives and local generated material.
# Metro bundles the shared runtime from backend/src. Exclude backend build/data
# material while keeping the source and package metadata available remotely.
backend/*
!backend/src/
!backend/src/**
!backend/package.json
!backend/pnpm-lock.yaml
!backend/tsconfig.json
backend/node_modules/
backend/.codex-*/
backend/data/
backend/dist/
control-center/
docs/
marketing/
tools/
supabase/
output/
artifacts/
.codex/
.codex-*/
.codex-upstream/
.codex-v21-reference/
.pnpm-store/
VELDRYN_v17_SocialLiveOpsPartyEvents/
VELDRYN_v21_SunscarFrostmarch/

apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/.expo-*/
apps/mobile/.codex-*/
apps/mobile/.core-build/
apps/mobile/.onboarding-build/
apps/mobile/.pet-test-build/
apps/mobile/.search-loadouts-build/
apps/mobile/.affinity-build/
apps/mobile/.profile-core-build/
apps/mobile/.combat-*/
apps/mobile/*-export/
apps/mobile/art-review/
apps/mobile/tests/
apps/mobile/*.log
