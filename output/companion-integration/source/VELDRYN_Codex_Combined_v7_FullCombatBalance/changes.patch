+// 3 level requirements.
+const low={...owned,UNIT_015:p('UNIT_015',14)};ok(!validateCompanionMissionTeam({missionId:'MISSION_SUNSCAR_4H',companionIds:['UNIT_015','UNIT_014'],owned:low,assignments:[],equippedCompanionIds:new Set(),expeditionPensLevel:1}).ok,'Level requirement ignored');
