    "coop-phase7": "node dist/server/coop/__tests__/phase7-matchmaking.js",
    "coop-phase7-runtime": "node dist/server/coop/__tests__/phase7-runtime-adapter.js",
    "coop-phase8": "node dist/server/coop/__tests__/phase8-ready-recovery.js",
    "coop-phase9": "node dist/server/coop/__tests__/phase9-voting.js",
    "coop-phase10": "node dist/server/coop/__tests__/phase10-chat.js",
    "coop-phase11": "node dist/server/coop/__tests__/phase11-rewards.js",
    "coop-phase12": "node dist/server/coop/__tests__/phase12-balance.js",
    "coop-phase13": "node dist/server/coop/__tests__/phase13-regional-content.js",
    "guild-progression-smoke": "node dist/server/guild/__tests__/progression-smoke.js",
    "coop-phase14": "node dist/server/coop/__tests__/phase14-roguelite-builds.js",
    "coop-phase15": "node dist/server/coop/__tests__/phase15-qmode-roguelite.js",
    "coop-phase16": "node dist/server/coop/__tests__/phase16-tier-modifiers.js",
    "coop-phase17": "node dist/server/coop/__tests__/phase17-qmode-command-boundary.js",
    "coop-phase18": "node dist/server/coop/__tests__/phase18-qmode-persistence.js",
    "coop-phase19": "node dist/server/coop/__tests__/phase19-live-roguelite.js",
