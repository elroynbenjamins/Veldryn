  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "supabase": "2.117.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  }
}
