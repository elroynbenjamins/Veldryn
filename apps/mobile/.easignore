# Dependencies are installed by EAS.
node_modules/
**/node_modules/
.pnpm-store/

# Local Expo/build output and generated previews.
.expo/
.expo-*/
dist/
.expo-export*/
.readiness-export/
.codex-tmp/
.codex-*/
.core-build/
.onboarding-build/
.pet-test-build/
.search-loadouts-build/
.affinity-build/
.profile-core-build/
.combat-*/
.readiness-export/
.next-pass-export/
.herbalism-export/
.faith-export/
.roster-export/
.companion-export/
.exploration-export/
.web-pet-preview/

# Review-only material is not part of the app bundle.
art-review/

# Test sources and local logs are not needed by the release build.
tests/
*.log
.codex-tmp-*

# Catch-all for generated review/build/export snapshots.
# These folders can contain complete copies of the app and hundreds of MB of generated assets.
.*-export*/
.*-build*/
*-export/
*-build/
.expo-helmet-check/

# Source/archive files are never required by the runtime bundle.
*.zip
*.psd
*.psb
*.ai
*.xcf
*.kra

# This EAS project lives in a monorepo. Patterns above are resolved from the
# repository root during archive creation, so explicitly exclude the mobile
# machine outputs as well as their project-local spellings. These are all
# generated/review inputs; Metro does not need them for a production bundle.
apps/mobile/node_modules/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/
apps/mobile/.expo-*/
apps/mobile/.codex-*/
apps/mobile/.*-export*/
apps/mobile/.*-build*/
apps/mobile/*-export/
apps/mobile/*-build/
apps/mobile/dist/
apps/mobile/.web-pet-preview/
apps/mobile/.codex-tmp/
apps/mobile/.expo-helmet-check/
apps/mobile/art-review/
apps/mobile/art-archive/
apps/mobile/tests/
apps/mobile/*.log

# Local scratch/export/audit snapshots that only live on dev machines.
apps/mobile/.release-*/
apps/mobile/.release-*-audit*/
apps/mobile/.release-readiness-*/
apps/mobile/.release-bundle-*/
apps/mobile/.release-size-*/
apps/mobile/.web-scratch/
apps/mobile/.browser-review-export/
apps/mobile/.remaster-export/
apps/mobile/.chat-ui-v11-export/
apps/mobile/.expo-export-aab-check/
apps/mobile/.codex-aab-export/
apps/mobile/.*-export/
apps/mobile/.*-build/
apps/mobile/*-export/
apps/mobile/*-build/
# Repeat without the apps/mobile/ prefix in case EAS resolves from the eas.json directory.
.release-*/
.release-*-audit*/
.release-readiness-*/
.release-bundle-*/
.release-size-*/
.web-scratch/
.browser-review-export/
.remaster-export/
.chat-ui-v11-export/
.expo-export-aab-check/
.codex-aab-export/
.*-export/
.*-build/
*-export/
*-build/

# Monorepo material not used by the mobile Metro build.
control-center/
docs/
marketing/
tools/
supabase/
output/
artifacts/
.codex/
.codex-*/
.codex-upstream/
.codex-v21-reference/
.codex-remote-attachments/
.visual-polish-core-check/
VELDRYN_v17_SocialLiveOpsPartyEvents/
VELDRYN_v21_SunscarFrostmarch/
cargo_charter_visual_pack_v1.zip

# Mobile imports a small shared backend source surface. Keep only that surface
# rather than uploading backend data, build outputs, and installed packages.
backend/*
!backend/src/
!backend/src/**
!backend/package.json
!backend/pnpm-lock.yaml
!backend/tsconfig.json
