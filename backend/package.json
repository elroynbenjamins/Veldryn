    "coop-phase1": "node dist/server/coop/__tests__/phase1-invariants.js",
    "coop-phase2": "node dist/server/coop/__tests__/phase2-lifecycle.js",
    "coop-phase2-runtime": "node dist/server/coop/__tests__/phase2-runtime-adapter.js",
    "coop-phase2-contracts": "node dist/server/coop/__tests__/phase2-api-contracts.js",
    "coop-phase3": "node dist/server/coop/__tests__/phase3-normalization.js",
    "coop-phase3-commit": "node dist/server/coop/__tests__/phase3-roster-commit.js",
    "coop-phase4": "node dist/server/coop/__tests__/phase4-routes.js",
    "coop-phase5": "node dist/server/coop/__tests__/phase5-stateful-run.js",
    "coop-phase6": "node dist/server/coop/__tests__/phase6-qmode.js",
    "coop-phase6-projection": "node dist/server/coop/__tests__/phase6-public-projection.js",
    "coop-phase7": "node dist/server/coop/__tests__/phase7-matchmaking.js",
    "coop-phase7-runtime": "node dist/server/coop/__tests__/phase7-runtime-adapter.js",
