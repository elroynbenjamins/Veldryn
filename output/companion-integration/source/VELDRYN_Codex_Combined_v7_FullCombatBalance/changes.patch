+export interface CompanionIdempotentTransactionRepository<State>{
+ transact<T>(input:{accountId:string;action:string;requestId:string;fingerprint:string},work:(state:State)=>Promise<{state:State;result:T}>|{state:State;result:T}):Promise<T>;
+}
+function stable(value:unknown):string{if(value===null||typeof value!=='object')return JSON.stringify(value);if(Array.isArray(value))return `[${value.map(stable).join(',')}]`;const o=value as Record<string,unknown>;return `{${Object.keys(o).sort().map(k=>`${JSON.stringify(k)}:${stable(o[k])}`).join(',')}}`;}
+export function companionRequestFingerprint(action:string,payload:unknown){const text=`${action}|${stable(payload)}`;let a=2166136261>>>0,b=0x9e3779b9;for(const ch of text){a^=ch.charCodeAt(0);a=Math.imul(a,16777619)>>>0;b=(Math.imul(b^a,2246822519)+ch.charCodeAt(0))>>>0;}return `${a.toString(16).padStart(8,'0')}${b.toString(16).padStart(8,'0')}`;}
+export async function runCompanionCommand<State,T>(repo:CompanionIdempotentTransactionRepository<State>,accountId:string,action:string,requestId:string,payload:unknown,work:(state:State)=>Promise<{state:State;result:T}>|{state:State;result:T}){if(!accountId)throw new Error('unauthenticated');if(!requestId||requestId.length<2)throw new Error('request_id_required');return repo.transact({accountId,action,requestId,fingerprint:companionRequestFingerprint(action,payload)},work);}
