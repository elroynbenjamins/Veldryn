    "test:companions": "node -e \"require('fs').rmSync('.companions-build',{recursive:true,force:true})\" && tsc -p tsconfig.companions.json && node -e \"const fs=require('fs'),cp=require('child_process');for(const f of fs.readdirSync('.companions-build/__tests__').filter(x=>x.endsWith('.js')).sort())cp.execFileSync(process.execPath,['.companions-build/__tests__/'+f],{stdio:'inherit'})\"",
    "typecheck:combat-balance": "tsc -p tsconfig.combat-balance.json --noEmit",
    "test:combat-balance": "node -e \"require('fs').rmSync('.combat-balance-build',{recursive:true,force:true})\" && tsc -p tsconfig.combat-balance.json && node .combat-balance-build/__tests__/combat-balance-contracts.js"
