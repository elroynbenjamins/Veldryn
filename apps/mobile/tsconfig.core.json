{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/core/**/*.ts",
    "src/content/**/*.ts",
    "src/dev/**/*.ts",
    "tests/**/*.ts"
  ]
}
