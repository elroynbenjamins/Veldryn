    "test:merged-content": "tsc --outDir dist-merged && node dist-merged/server/content/sunscar-v20.test.js && node dist-merged/server/content/region-v21.test.js && node dist-merged/server/live-dungeon/live-dungeon-v20.test.js && node dist-merged/server/guild/guild-projects-v18.test.js && node dist-merged/server/shared-world/shared-world-v19.test.js",
    "typecheck:companions": "tsc -p tsconfig.companions.json --noEmit",
    "test:companions": "node ../tools/test-companions.mjs",
    "build": "tsc",
    "typecheck:online": "tsc -p tsconfig.online.json --noEmit",
    "build:online": "tsc -p tsconfig.online.json && node ../tools/build-online.mjs",
    "test:online": "tsc -p tsconfig.online.json && node dist/online/backend/online/tests/gameplay.js && node dist/online/backend/online/tests/coop-loadout.js && node dist/online/backend/online/tests/coop-entry.js && node dist/online/backend/online/tests/qmode-runtime.js && node dist/online/backend/online/tests/event-expedition-runtime.js && node dist/online/backend/online/tests/live-queue.js && node dist/online/backend/online/tests/live-ready.js && node dist/online/backend/online/tests/coop-published-balance.js",
