# Public values only. Never put the Supabase service-role key in a mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Use the deployed authenticated gameplay endpoint and server-owned saves.
EXPO_PUBLIC_SERVER_GAMEPLAY=false
EXPO_PUBLIC_COOP_ROGUELITE_V1=false
EXPO_PUBLIC_COOP_API_URL=https://YOUR_SERVER.example.com
