{
  "expo": {
    "name": "VELDRYN",
    "slug": "veldryn",
    "scheme": "veldryn",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/app-icon-v1/icon-1024.png",
    "android": {
      "package": "com.elroybenjamins.veldryn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-v1/android-foreground-1024.png",
        "backgroundColor": "#101C2C",
        "monochromeImage": "./assets/app-icon-v1/android-monochrome-1024.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.elroybenjamins.veldryn"
    },
    "extra": {
      "eas": {
        "projectId": "6e230e97-f7e2-4e92-832e-b3d3b4e91ce3"
      }
    },
    "plugins": [
      "expo-iap",
      "./plugins/with-kotlin-compile-stdlib-pin",
      "react-native-nitro-google-signin"
    ]
  }
}
