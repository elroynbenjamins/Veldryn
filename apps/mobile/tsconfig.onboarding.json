{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "outDir": ".onboarding-build",
    "noEmit": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/content/**/*.ts",
    "tests/onboarding-guide-v1.ts",
    "tests/first-session-tutorial.ts",
    "tests/character-creation-onboarding.ts",
    "tests/assertions.ts",
    "tests/test-assert.ts",
    "tests/node-shim.d.ts"
  ]
}
