{
  "name": "veldryn-offline-prototype",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "test:core": "node -e \"require('fs').rmSync('.core-build',{recursive:true,force:true})\" && tsc -p tsconfig.core.json --outDir .core-build && node .core-build/tests/offline-smoke.js && node .core-build/tests/character-skins.js && node .core-build/tests/save-transfer.js && node .core-build/tests/localization.js && node .core-build/tests/live-events.js",
    "test:pre-codex": "node -e \"require('fs').rmSync('.core-build',{recursive:true,force:true})\" && tsc -p tsconfig.core.json --outDir .core-build && node .core-build/tests/offline-smoke.js && node .core-build/tests/pre-codex-smoke.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~53.0.0",
    "expo-linking": "^57.0.9",
    "expo-secure-store": "^57.0.3",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.5"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
