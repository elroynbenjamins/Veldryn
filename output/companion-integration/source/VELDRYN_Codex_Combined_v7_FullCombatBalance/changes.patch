+prog=p('UNIT_004',20,2,7);const first=selectCompanionTechnique(prog,'UNIT_004_EXECUTIONER',economy);eq(first.cost.gold,0,'First Technique was not free');eq(first.cost.companionEssence,0,'First Technique Essence cost');eq(first.progress.selectedTechniqueId,'UNIT_004_EXECUTIONER','First Technique not selected');
