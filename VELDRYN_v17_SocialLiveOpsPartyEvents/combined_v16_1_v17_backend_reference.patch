+      requiredAnyTags: ['poison', 'antidote', 'tainted'], dailyAccountCreditCap: 2400,
+      minimumCategoryFraction: { combat: 0.25, skilling: 0.25 }, activityMultipliers: { alchemy: 1.08 },
+    },
