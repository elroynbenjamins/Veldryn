{
  "name": "veldryn-backend-foundation",
  "private": true,
  "version": "2.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "smoke": "node dist/server/expeditions/__tests__/smoke.js",
    "combat-smoke": "node dist/server/combat/__tests__/combat-smoke.js",
    "combat-matrix": "node dist/server/combat/__tests__/party-matrix.js",
    "combat-service-smoke": "node dist/server/combat/__tests__/service-smoke.js",
    "backend-pass-smoke": "node dist/server/__tests__/backend-pass-smoke.js",
    "production-smoke": "node dist/server/__tests__/production-smoke.js",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:env": "supabase status -o env",
    "supabase:reset": "supabase db reset",
    "supabase:test-db": "supabase test db",
    "squad-smoke": "node dist/server/squads/__tests__/squad-smoke.js",
    "coop-phase1": "node dist/server/coop/__tests__/phase1-invariants.js",
    "coop-phase2": "node dist/server/coop/__tests__/phase2-lifecycle.js",
