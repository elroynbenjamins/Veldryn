    "profile-smoke": "node dist/server/profiles/__tests__/profile-application.js",
    "profile-migration-static": "node ..\\\\tools\\\\verify-profile-migration.mjs",
    "achievement-smoke": "node dist/server/achievements/__tests__/achievement-application.js",
    "achievement-migration-static": "node ..\\\\tools\\\\verify-achievement-migration.mjs",
    "guild-progression-smoke": "node dist/server/guild/__tests__/progression-smoke.js",
    "guild-tag-smoke": "node dist/server/guild/__tests__/tags-v53-smoke.js",
    "guild-tag-migration-static": "node ..\\\\tools\\\\verify-guild-tag-migration.mjs",
    "guild-appearance-migration-static": "node ..\\\\tools\\\\verify-guild-appearance-migration.mjs",
    "guild-completion-smoke": "node dist/server/guild/__tests__/guild-completion.js",
    "party-v16": "node dist/server/party/__tests__/party-v16.js",
    "recruitment-test": "node dist/server/social/recruitment.test.js",
    "guild-recruitment-v17": "node dist/server/social/guild-recruitment-v17.test.js",
    "liveops-v17": "node dist/server/liveops/__tests__/party-events-v17.js && node dist/server/liveops/__tests__/party-event-service-v17.js && node dist/server/liveops/__tests__/finalization-rewards-v17.js && node dist/server/liveops/__tests__/outbox-v17.js",
    "combat-rng-portable": "node dist/server/combat/__tests__/portable-rng.js",
    "test:coop-live-social": "tsc -p tsconfig.online.json && node dist/online/backend/online/tests/live-queue.js && node dist/online/backend/online/tests/coop-lfg.js",
    "test:coop-composition": "tsc -p tsconfig.coop-composition.json && node dist-coop-composition/server/coop/__tests__/phase6-qmode.js && node dist-coop-composition/server/coop/__tests__/phase6-public-projection.js && node dist-coop-composition/server/coop/__tests__/phase7-matchmaking.js && node dist-coop-composition/server/coop/__tests__/qa-echo-fixtures.js",
    "test:gems": "tsc -p tsconfig.gems.json && node dist-gems/server/equipment/gems/gem-v1.test.js && node dist-gems/server/combat/__tests__/gem-effects-v1.js"
