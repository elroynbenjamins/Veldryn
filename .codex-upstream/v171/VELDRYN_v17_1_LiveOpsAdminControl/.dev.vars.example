# Cloudflare Pages Function runtime configuration for local development.
# SUPABASE_SERVICE_ROLE_KEY is SECRET. Never put it in src/, config.js, Git, or the mobile app.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
CONTROL_ALLOWED_ORIGIN=http://localhost:8788
