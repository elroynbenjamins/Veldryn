{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "../..",
    "jsx": "react-jsx"
  },
  "include": [
    "src/core/**/*.ts",
    "src/content/**/*.ts",
    "src/dev/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/world-boss-real-loadout-v12.ts",
    "tests/world-boss-guard-role-v13.ts",
    "tests/world-boss-bracket-audit-v14.ts"
  ]
}
