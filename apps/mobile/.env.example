# Public values only. Never put the Supabase service-role key in a mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Use the deployed authenticated gameplay endpoint and server-owned saves.
EXPO_PUBLIC_SERVER_GAMEPLAY=false
EXPO_PUBLIC_COOP_ROGUELITE_V1=false
EXPO_PUBLIC_COOP_API_URL=https://YOUR_SERVER.example.com


# Native Android Google account sign-in. This is the public Web OAuth client ID,
# not a client secret. Configure the matching client ID + secret in Supabase Auth.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Optional Google Play Games Services v2 numeric project ID. When omitted, the
# Play Games auto-init provider is removed so Google account sign-in still works.
EXPO_PUBLIC_GOOGLE_PLAY_GAMES_PROJECT_ID=YOUR_PLAY_GAMES_PROJECT_ID
