+  activityMultipliers?: Partial<Record<LiveOpsActivityKind, number>>;
+  challengeMultipliers?: Partial<Record<ContributionChallenge, number>>;
+  minimumCategoryFraction?: Partial<Record<ContributionCategory, number>>;
