{
  "version": "1.0.0",
  "themes": [
    {
      "id": "harvestwake",
      "name": "Harvestwake",
      "motif": "warm bronze entwined with amber leaves and golden wheat; a small amber lantern at the upper central crest",
      "scene": "Autumn medieval valley at golden sunset, foreground cobblestone terrace framed by amber trees and small glowing lanterns, harvested fields winding down toward a river and a distant fortified fantasy city. Warm windows, subtle magical blue crystals, late golden sunlight and deep navy shadows. Expansive quiet upper sky."
    },
    {
      "id": "winters_bell",
      "name": "Winter's Bell",
      "motif": "aged gold with silver frost filigree, tiny angular ice crystals and a small winter bell at the upper central crest",
      "scene": "Snowy medieval mountain citadel at twilight, distant spires above a frozen lake and a stone bridge, soft aurora in a deep indigo sky, snow laden pines along the lower edges, welcoming warm amber windows and lanterns. A serene winter wonderland, crisp cyan ice against navy snow shadows. Large quiet upper sky."
    },
    {
      "id": "firstlight",
      "name": "VELDRYN Anniversary · Firstlight",
      "motif": "gold and bronze ceremonial laurel, saturated blue crystal inlays, small radiant blue diamond star at the upper central crest",
      "scene": "Ancient forest kingdom at first light, a grand gold-and-stone arched bridge crossing a turquoise river toward a distant castle and luminous blue crystal obelisk, mossy ruins and deep evergreen trees at the edges, blue-and-gold unmarked ceremonial banners, tiny golden motes in morning light. Wonder and adventure with generous peaceful upper sky."
    }
  ],
