+/**
+ * VELDRYN full-combat balance authority.
+ *
+ * This module intentionally separates three things that had become conflated in
+ * older content tables:
+ *  - UI / recommendation power,
+ *  - real combat-stat scaling,
+ *  - progression time/economy pacing.
+ *
+ * Keep runtime-specific combat simulators authoritative for outcomes. These
+ * values are guardrails and cross-system contracts, not a replacement for the
+ * combat engine.
+ */
+export type BalanceEvidence='runtime_verified'|'seeded_verified'|'data_calibrated'|'real_repo_required';
+export type CombatRole='tank'|'damage'|'support';
+
+export const FULL_COMBAT_BALANCE_VERSION='2026-09-12.v1';
+
+export const CHARACTER_PROGRESSION_BALANCE={
+  /** Current implemented idle/combat-only Asterfall test band. */
+  asterfallLevel25ProductiveCombatHours:{min:175,max:288,evidence:'runtime_verified' as BalanceEvidence},
+  /** Observed/accepted player-profile calendar pacing around the current idle loop. */
+  asterfallCalendarDays:{
+    normal:{min:35,max:55},
+    active:{min:24,max:38},
+    optimizer:{min:18,max:30},
+  },
+  /** Historical vertical-slice target must not be used as the character-XP authority. */
+  supersededVerticalSliceActiveEquivalentHours:{min:18,max:30,superseded:true},
+  openingLevel5Minutes:{min:20,max:60},
+  bossFirstClearSeriousAttempts:{min:2,max:6},
+} as const;
+
+export interface ClassOutputBudget{
+  id:string;name:string;role:CombatRole;minPureDpsReference:number;maxPureDpsReference:number;identity:string;evidence:BalanceEvidence;
+}
