+import { scoreContribution, type AuthoritativeContributionProfile, type ContributionCategory } from '../party/party-contracts';
+import type { EventContributionRules, LiveOpsActivityKind, PartyLiveOpsEventDefinition } from './event-definitions';
+
+export interface SocialContributionEvent {
+  /** Globally idempotent settlement/event ID generated by trusted server code. */
+  sourceEventId: string;
+  accountId: string;
+  occurredAtMs: number;
+  dateKey: string;
+  profile: AuthoritativeContributionProfile;
+  units: number;
+  activityKind: LiveOpsActivityKind;
+  contentId: string;
+  regionId?: string;
+  tags?: readonly string[];
+  /** Trusted server snapshot taken when the underlying activity settlement commits. */
+  partyIdAtSettlement?: string;
+  partyNameAtSettlement?: string;
+}
+
+export interface EventContributionScore {
+  eligible: boolean;
+  reason?: string;
+  basePoints: number;
+  eventPoints: number;
+  category: ContributionCategory;
+  activityKind: LiveOpsActivityKind;
+}
+
+function hasIntersection(a: readonly string[] | undefined, b: readonly string[] | undefined): boolean {
+  if (!a || a.length === 0) return true;
+  if (!b || b.length === 0) return false;
+  const set = new Set(b);
+  return a.some((value) => set.has(value));
+}
+
+export function contributionEligibleForRules(event: SocialContributionEvent, rules: EventContributionRules): { eligible: boolean; reason?: string } {
+  if (!rules.allowedCategories.includes(event.profile.category)) return { eligible: false, reason: 'category_not_eligible' };
+  if (rules.allowedActivityKinds && !rules.allowedActivityKinds.includes(event.activityKind)) return { eligible: false, reason: 'activity_not_eligible' };
+  if (rules.allowedRegionIds && (!event.regionId || !rules.allowedRegionIds.includes(event.regionId))) return { eligible: false, reason: 'region_not_eligible' };
+  if (rules.requiredAnyTags && !hasIntersection(rules.requiredAnyTags, event.tags)) return { eligible: false, reason: 'event_tag_not_eligible' };
+  return { eligible: true };
+}
+
+export function scoreLiveOpsContribution(event: SocialContributionEvent, definition: PartyLiveOpsEventDefinition): EventContributionScore {
+  const eligibility = contributionEligibleForRules(event, definition.contributionRules);
+  const basePoints = scoreContribution({ profile: event.profile, units: event.units });
+  if (!eligibility.eligible || basePoints <= 0) {
+    return { eligible: false, reason: eligibility.reason ?? 'no_points', basePoints, eventPoints: 0, category: event.profile.category, activityKind: event.activityKind };
+  }
+  const activityMultiplier = definition.contributionRules.activityMultipliers?.[event.activityKind] ?? 1;
+  const challengeMultiplier = definition.contributionRules.challengeMultipliers?.[event.profile.challenge] ?? 1;
+  const eventPoints = Math.max(1, Math.round(basePoints * activityMultiplier * challengeMultiplier));
+  return { eligible: true, basePoints, eventPoints, category: event.profile.category, activityKind: event.activityKind };
+}
+
+export function cappedEventCredit(rawEventPoints: number, pointsCreditedToday: number, dailyCap: number): number {
+  if (!Number.isFinite(rawEventPoints) || rawEventPoints <= 0) return 0;
+  const remaining = Math.max(0, Math.floor(dailyCap) - Math.max(0, Math.floor(pointsCreditedToday)));
+  return Math.min(Math.floor(rawEventPoints), remaining);
+}
